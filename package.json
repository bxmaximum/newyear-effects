{
  "name": "@bxmax/newyear-effects",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "New Year visual effects module for 1C-Bitrix",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/chef-build.mjs",
    "build:engine": "node tools/chef-build.mjs newyear.effects.engine",
    "build:admin": "node tools/chef-build.mjs newyear.effects.admin",
    "lint:admin": "node tools/chef-build.mjs --lint newyear.effects.admin",
    "test": "npm run test:php && npm run test:js",
    "test:php": "php -d auto_prepend_file= tests/php/run.php && php -d auto_prepend_file= tests/php/installer-main23.php",
    "test:js": "node --test install/js/newyear/effects/engine/tests/js/*.test.mjs"
  },
  "devDependencies": {
    "@bitrix/chef": "2.4.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@oxc-parser/binding-linux-x64-gnu": "0.152.0",
    "@oxlint/binding-linux-x64-gnu": "1.87.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.19",
    "@rollup/rollup-linux-x64-gnu": "4.68.8",
    "@typescript/typescript-linux-x64": "7.1.0-dev.20260928.1",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
